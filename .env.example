# CatCare-Hub local-only configuration template.
# Copy this file to .env. Never commit the real .env or any production data.

# Optional database override. Leave blank to use data/catcare.db.
CATCARE_DATABASE_URL=

# Local request boundary. Password login is intentionally disabled.
CATCARE_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CATCARE_TRUSTED_ORIGINS=http://localhost:5180,http://127.0.0.1:5180

# P5 backend map adapter. Supported: disabled, amap.
CATCARE_MAP_PROVIDER=disabled
CATCARE_AMAP_WEB_KEY=
CATCARE_HOME_LATITUDE=
CATCARE_HOME_LONGITUDE=
CATCARE_MAP_CITY=
CATCARE_MAP_TIMEOUT_SECONDS=8

# P5 browser basemap. These values are only used by the local Vite frontend.
VITE_AMAP_JS_API_KEY=
VITE_AMAP_JS_API_SECURITY_CODE=

# GPT route ordering uses a separate OpenAI API account. Codex login is not used.
OPENAI_API_KEY=
CATCARE_OPENAI_ROUTE_MODEL=gpt-5.6
CATCARE_OPENAI_TIMEOUT_SECONDS=15
