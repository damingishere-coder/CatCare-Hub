{
  "name": "catcare-hub-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "preview:public": "vite preview --config vite.public.config.ts",
    "build": "tsc -b && vite build",
    "build:public": "tsc -b && vite build --config vite.public.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest"
  },
  "dependencies": {
    "@dnd-kit/helpers": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "lucide-react": "1.33.0",
